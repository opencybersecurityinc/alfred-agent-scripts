{
  "numStartups": 12,
  "mcpServers": {
    "github": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-github"],
      "env": { "GITHUB_PERSONAL_ACCESS_TOKEN": "ghp_CANARYabcdefghijklmnopqrstuvwxyz0123" }
    },
    "remote-docs": {
      "type": "http",
      "url": "https://bob:CANARYpass@docs.example.com/mcp?api_key=CANARYquery#frag",
