        "db": {
          "command": "postgres-mcp",
          "args": ["postgresql://app:CANARYdbpass@db.internal:5432/app", "--password", "CANARYflagvalue", "--read-only"]
        }
      }
    },
    "/work/missing": { "mcpServers": {} }
  }
